# Copy to .env and adjust. The server reads plain environment variables; use
# your shell, direnv, or your process manager to load this file.

# REQUIRED. The service refuses to start without it -- defaulting an auth
# credential would mean shipping with a known password.
ADMIN_API_TOKEN=change-me

# HTTP listen address.
ADDR=:8080

# SQLite database file. The parent directory is created on boot.
# WAL sidecar files (-wal, -shm) appear alongside it.
DB_PATH=./data/qdt.db

# Absolute base URL for canonical links and sitemap entries. Must include the
# scheme. Set this to the public hostname in production, or search engines will
# index localhost URLs.
PUBLIC_BASE_URL=http://localhost:8080

# Scheduler. A publish lands within roughly one poll interval of its run_at.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_INTERVAL=1s
# Must exceed the poll interval, or a second worker can steal a job that is
# still being worked on. The server refuses to start otherwise.
SCHEDULER_LEASE_TTL=30s
SCHEDULER_BATCH_SIZE=10

# Bound on graceful shutdown.
SHUTDOWN_TIMEOUT=10s

# Structured JSON logs instead of human-readable text.
LOG_JSON=false
